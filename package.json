{
  "name": "hawk-status",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "monitor": "node --experimental-strip-types src/monitor.ts",
    "notify": "node --experimental-strip-types src/notify.ts",
    "publish": "node --experimental-strip-types src/publish.ts",
    "serve": "npm run publish && python3 -m http.server 8000 -d dist"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
